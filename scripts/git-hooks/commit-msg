#!/bin/sh
# Commits are the user's own work for judging: refuse any AI co-author / attribution trailer.
# Matches the tools, not people: a teammate called Claude (or a co-author from Egypt) still gets through.
if grep -qiE '^(co-authored-by|generated[- ]with|signed-off-by):.*(@anthropic\.com|@openai\.com|copilot|chatgpt|claude (code|opus|sonnet|haiku|fable))|Generated with \[Claude' "$1"; then
  echo "commit-msg: AI attribution trailer found; remove it (CLAUDE.md §7)." >&2
  exit 1
fi
